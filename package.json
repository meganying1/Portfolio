{
  "name": "megan-ying-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/legacy-links.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/legacy-links.mjs",
    "build": "next build",
    "postbuild": "node scripts/finalize-export.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:assets": "node scripts/generate-site-assets.mjs",
    "verify:export": "node scripts/verify-export.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tegaki": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.6.2",
    "sharp": "0.35.5",
    "typescript": "^5.9.3"
  }
}
